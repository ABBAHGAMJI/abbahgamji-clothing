# Copy this file to .env.local and fill in real values.

# Base URL of the ABBAHGAMJI backend API (the Express project), no trailing slash.
# Local dev:  http://localhost:4000
# Production: https://your-backend.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:4000

# Your Flutterwave PUBLIC key (Settings -> API Keys in the Flutterwave dashboard).
# Safe to expose in the browser — this is the publishable key, not the secret one.
# The secret key stays in the backend's .env, never here.
NEXT_PUBLIC_FLW_PUBLIC_KEY=FLWPUBK_TEST-REPLACE-WITH-YOUR-REAL-PUBLIC-KEY-X
