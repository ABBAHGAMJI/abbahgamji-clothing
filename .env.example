# Copy this file to .env and fill in real values. Never commit your real .env.

PORT=4000

# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Any long random string — this is the password you'll use to log into
# /admin.html. Generate the same way as JWT_SECRET.
ADMIN_TOKEN=

# From your Flutterwave dashboard: Settings -> API Keys. Start with the
# TEST secret key while you're building.
FLW_SECRET_KEY=

# The public URL your storefront is served from. Used to build magic login
# links (e.g. https://your-app.onrender.com). Defaults to
# http://localhost:PORT if left blank, which is fine for local testing.
FRONTEND_URL=

# --- Outgoing email (optional) ---
# Used for magic-link logins AND order emails (order-received/verify-your-
# email, and payment-confirmed). If these are left blank, everything still
# works — the server logs each link to the console (and the relevant API
# response includes it directly for magic-link login), so you can test the
# whole flow before wiring up real email sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ABBAHGAMJI <no-reply@abbahgamji.com>"
